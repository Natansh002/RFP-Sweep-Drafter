# Local CLI and dashboard: nothing to configure. Optional:
# PORT=4173            dashboard port (it always binds to 127.0.0.1)

# n8n only: the workflow ids n8n assigns on import. Read them from each workflow's URL.
# Config is embedded in the workflows at build time, so there is no config URL to set
# and no link from n8n to a git server or any internal system.
SWEEPER_CORE_WORKFLOW_ID=
SWEEPER_RUN_WORKFLOW_ID=

# Deploying to your n8n (npm run deploy:n8n). Put these in .env.local, which is
# gitignored, never in this file.
# N8N_URL=https://your-instance.app.n8n.cloud
# N8N_API_KEY=            n8n → Settings → n8n API → Create an API key
